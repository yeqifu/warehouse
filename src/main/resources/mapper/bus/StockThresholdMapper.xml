<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeqifu.bus.mapper.StockThresholdMapper">

    <!-- 根据商品ID查询阈值设置 -->
    <select id="selectByGoodsid" resultType="com.yeqifu.bus.entity.StockThreshold">
        SELECT * FROM bus_stock_threshold WHERE goodsid = #{goodsid}
    </select>

    <!-- 查询所有启用了预警的商品阈值设置 -->
    <select id="selectAllEnabledThresholds" resultType="com.yeqifu.bus.entity.StockThreshold">
        SELECT * FROM bus_stock_threshold WHERE warningenabled = 1
    </select>

    <!-- 查询需要预警的商品 -->
    <select id="selectWarningGoods" resultType="com.yeqifu.bus.entity.StockThreshold">
        SELECT st.* FROM bus_stock_threshold st
        INNER JOIN bus_goods g ON st.goodsid = g.id
        WHERE st.warningenabled = 1
        AND (g.number &lt; st.minstock OR g.number &gt; st.maxstock)
    </select>

</mapper>
